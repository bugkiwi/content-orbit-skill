    },
    {
      "id": "it", "languageCode": "it", "country": "IT", "locationCode": 2380,
      "articleBase": "/it/blog", "seedKeywords": ["sostituire con la categoria del prodotto"],
      "internalLinks": [{"path": "/it", "label": "Il prodotto"}, {"path": "/it/prezzi", "label": "Prezzi attuali"}]
