{
  "version": 1,
  "name": "Example Project",
  "siteUrl": "https://example.com",
  "root": ".",
  "description": "A project-specific product description maintained by the owner; replace with verified current capabilities.",
  "audience": "The actual customers and the problems this project helps them solve.",
  "author": "Example Project",
  "factFiles": ["product-facts.md"],
  "exclusions": ["Unsupported features, invented customer stories and unverified product promises"],
